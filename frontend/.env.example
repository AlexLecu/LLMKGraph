# Copy to `.env.local` for local overrides (git-ignored). All values are optional;
# defaults point at the local docker-compose / manual setup.
VITE_API_URL=http://localhost:5555
VITE_GRAPHDB_URL=http://localhost:7200
# Chat API (backend/weaviate_rag/chat_api.py: start the chatbot with CHAT_UI=api)
VITE_CHAT_API_URL=http://localhost:8000
# Base path when hosting under a sub-path (e.g. /LLMKGraph/)
VITE_BASE_PATH=/
