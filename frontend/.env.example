# Copy to `.env.local` for local overrides (git-ignored). All values are optional;
# defaults point at the local docker-compose / manual setup.
VITE_API_URL=http://localhost:5555
VITE_GRAPHDB_URL=http://localhost:7200
# Chat API (start the chatbot with CHAT_UI=api); or embed a Chainlit UI instead
VITE_CHAT_API_URL=http://localhost:8000
# VITE_CHAT_EMBED_URL=http://localhost:8000
# Base path when hosting under a sub-path (e.g. GitHub Pages: /LLMKGraph/)
VITE_BASE_PATH=/
# Hide the Evaluation tab (deployments without the LLM comparison repositories)
VITE_HIDE_EVALUATION=false
