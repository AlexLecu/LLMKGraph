# Copy this file to `.env` and fill in the values you need.
# `.env` is git-ignored; never commit real keys.

# Used by the Flask backend (relation extraction) and the Streamlit app
OPENAI_API_KEY=
HUGGINGFACEHUB_API_TOKEN=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=

# Used by the Chainlit chatbot (backend/weaviate_rag) depending on provider
TOGETHER_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Infrastructure (defaults shown; override when deploying)
GRAPHDB_URL=http://localhost:7200
WEAVIATE_HOST=localhost
WEAVIATE_HTTP_PORT=8080
WEAVIATE_GRPC_PORT=50051
OLLAMA_HOST=http://localhost:11434

# Flask: never enable debug in production (exposes the Werkzeug debugger)
FLASK_DEBUG=0
# Comma-separated list of allowed browser origins, or * for development
CORS_ORIGINS=*

# --- Chainlit chatbot LLM backend (backend/weaviate_rag/chatbot.py) ---
# ollama (default, local models) or openai-compatible (Groq, OpenRouter, Gemini, Together, ...)
CHAT_PROVIDER=ollama
# Comma-separated; the first one is the default shown in the UI
CHAT_MODELS=llama3.2,deepseek-r1,gemma3
# Only for CHAT_PROVIDER=openai-compatible, e.g. Groq:
# CHAT_API_BASE_URL=https://api.groq.com/openai/v1
# CHAT_API_KEY=gsk_...
# CHAT_MODELS=llama-3.3-70b-versatile

# --- Weaviate (vector store for the chatbot) ---
# Weaviate Cloud instead of WEAVIATE_HOST (free 14-day sandbox at console.weaviate.cloud):
# WEAVIATE_URL=https://xxxx.weaviate.cloud
# WEAVIATE_API_KEY=...
# Or embedded (single container, Linux): WEAVIATE_MODE=embedded  WEAVIATE_DATA_PATH=./weaviate_data
