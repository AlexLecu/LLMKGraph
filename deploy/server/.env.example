# Copy to .env (git-ignored) next to docker-compose.yml.
PUBLIC_URL=https://llmkgraph.utcluj.ro
# Chat LLM (any OpenAI-compatible endpoint; Groq has a free tier)
GROQ_API_KEY=
# CHAT_API_BASE_URL=https://api.groq.com/openai/v1
# CHAT_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
# Host ports, bound to 127.0.0.1 only
WEB_PORT=3002
GRAPHDB_PORT=7201
GRAPHDB_HEAP=3g
# 1 = public site: graphs read-only except WRITABLE_REPOS; extraction with EXTRACTION_MODEL only.
# 0 = everything enabled (batch extraction needs the OpenAI/Mistral/DeepSeek keys)
READ_ONLY=1
# WRITABLE_REPOS=amd_playground
# EXTRACTION_MODEL=openai/gpt-oss-120b
